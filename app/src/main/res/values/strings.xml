    <!-- Interactive App Tutorial -->
    <string name="tutorial_badge">Quick Guide • %1$d of %2$d</string>
    <string name="tutorial_skip">Close</string>
    <string name="tutorial_back">Back</string>
    <string name="tutorial_next">Next</string>
    <string name="tutorial_done">Got it, let\'s start!</string>
    <string name="tutorial_step1_title">Your daily snapshot</string>
    <string name="tutorial_step1_body">Home shows how much is left to spend this month at a glance, along with your Safe / day allowance and top categories.</string>
    <string name="tutorial_step1_tip">Tap the days-left chip inside the top card anytime to see or change your monthly reset date.</string>
    <string name="tutorial_step2_title">Log expenses in 2 seconds</string>
    <string name="tutorial_step2_body">Tap the + button at the bottom anytime to type an amount, choose a category, and add an optional note.</string>
    <string name="tutorial_step2_tip">You can also mark an expense as a Recurring Bill or Subscription right while logging it.</string>
    <string name="tutorial_step3_title">Monthly budget overview</string>
    <string name="tutorial_step3_body">The Budgets tab compares your total monthly spending against your monthly limit with a clean gauge and category summary.</string>
    <string name="tutorial_step3_tip">Tap Set limit to pick a custom monthly cap, or use the arrows to review previous months.</string>
    <string name="tutorial_step4_title">Customize category limits</string>
    <string name="tutorial_step4_body">Switch to Category limits to slide targets for Dining, Groceries, Home, and more — or create your own categories.</string>
    <string name="tutorial_step4_tip">Progress bars shift from calm sage green to amber and coral as you approach a limit.</string>
    <string name="tutorial_step5_title">Activity, bills &amp; subscriptions</string>
    <string name="tutorial_step5_body">Search and filter every transaction, swipe left on any item to delete (with Undo), or switch to Bills &amp; Subs to manage recurring costs.</string>
    <string name="tutorial_step5_tip">Bills &amp; Subscriptions sit side-by-side so it\'s easy to tell essential bills from optional subscriptions.</string>
    <string name="tutorial_step6_title">Insights &amp; private backups</string>
    <string name="tutorial_step6_body">Use Insights to compare months and years with interactive charts. Open Settings anytime to customize themes, currency, or export &amp; import backups.</string>
    <string name="tutorial_step6_tip">You can replay this guide anytime by tapping the ? button on Home or in Settings.</string>

